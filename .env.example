NODE_ENV=development
PORT=3000
# Comma-separated allowed origins; empty = allow all (development)
CORS_ORIGINS=
SWAGGER_ENABLED=true

# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://offers:offers@localhost:5433/offers?schema=public"

# Access token signing secret. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-to-a-random-secret-of-at-least-32-chars"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# OAuth client IDs (comma-separated). Google: iOS, Android and web client IDs.
# Apple: the iOS app bundle ID. Leave empty until the apps are set up.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Test logins: POST /auth/dev/customer and seeded dev users. Never in production.
DEV_AUTH_ENABLED=true

# Uploaded photos. In production, Caddy serves UPLOADS_DIR and SERVE_UPLOADS=false.
UPLOADS_DIR=./uploads
PUBLIC_UPLOADS_URL=http://localhost:3000/uploads
SERVE_UPLOADS=true

# Minimum app versions. Raise one to force users of older versions to update.
PARTNER_APP_MIN_VERSION=1.0.0
CUSTOMER_APP_MIN_VERSION=1.0.0
ADMIN_APP_MIN_VERSION=1.0.0
